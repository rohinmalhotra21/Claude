# --- Core ---
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trainwithrohin
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-me
JWT_EXPIRES_IN=30d
CORS_ORIGINS=*

# --- Power BI: JSON feed (Web connector) ---
# Shared secret sent as the x-api-key header. Leave unset to disable the feed.
POWERBI_API_KEY=

# --- Power BI: streaming datasets (optional, for live tiles) ---
# Paste the push URL from each streaming dataset in the Power BI service.
POWERBI_PUSH_URL_WORKOUTS=
POWERBI_PUSH_URL_NUTRITION=
POWERBI_PUSH_URL_SUPPLEMENTS=
POWERBI_PUSH_URL_DAILY_LOG=
